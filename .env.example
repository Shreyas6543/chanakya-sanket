# ============================================================
# Chanakya Sanket — Environment Variables Template
# Copy this to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# --- Upstox API ---
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_API_SECRET=your_upstox_api_secret
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
UPSTOX_ACCESS_TOKEN=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# --- PostgreSQL ---
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading_secret
POSTGRES_DB=trading_engine
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- App Settings ---
ENV=development
LOG_LEVEL=INFO

# --- Trading Config ---
CAPITAL_BASE=500000
MAX_CAPITAL_PER_TRADE_PCT=10.0
RISK_PER_TRADE_PCT=1.5
MAX_DAILY_LOSS_PCT=5.0
MAX_OPEN_SIGNALS_PER_SYMBOL=2
MIN_CONFIDENCE_SCORE=60

# --- Lot Sizes (update if NSE changes) ---
NIFTY_LOT_SIZE=25
BANKNIFTY_LOT_SIZE=15

# --- Strike Intervals ---
NIFTY_STRIKE_INTERVAL=50
BANKNIFTY_STRIKE_INTERVAL=100

# --- Expiry ---
EXPIRY_MIN_DAYS=2

# --- Premium Estimation ---
PREMIUM_ATR_MULTIPLIER=1.2
PREMIUM_SL_LOSS_RATIO=0.5

# --- Strategy Points ---
POINTS_VWAP_BREAKOUT=20
POINTS_OI_BUILDUP=25
POINTS_RSI_MOMENTUM=15
POINTS_BULLISH_ENGULFING=15
POINTS_OPENING_RANGE=15
POINTS_POSITIVE_SENTIMENT=10

# --- Strategy Thresholds ---
RSI_CROSSOVER_LEVEL=55.0
VOLUME_SPIKE_MULTIPLIER=1.5
OI_BUILDUP_THRESHOLD=0.05
VWAP_TOLERANCE_PCT=0.002

# --- Instruments ---
INSTRUMENTS=NSE_INDEX|Nifty 50,NSE_INDEX|Nifty Bank
